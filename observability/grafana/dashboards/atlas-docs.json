{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Búsqueda p95",
      "id": 1,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1000 }] } }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(document_search_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Solicitudes por segundo",
      "id": 2,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(rate(document_api_http_requests_total[5m])) by (path, status)", "legendFormat": "{{path}} · {{status}}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Documentos aceptados",
      "id": 3,
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "sum(document_uploads_total)", "legendFormat": "uploads", "refId": "A" }]
